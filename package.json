{
  "name": "botao_da_copa",
  "version": "1.0.0",
  "description": "Projeto de bolao da Copa do Mundo FIFA 2026 com operacao principal via WhatsApp, governanca em skills e base compartilhada em Google Sheets.",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "tsx --test src/**/*.test.ts",
    "bootstrap:sheets": "tsx src/sheets/bootstrapSheets.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "import:bolao": "tsx src/sheets/importBolaoBase.ts",
    "reconcile:base": "tsx src/sheets/reconcileBaseState.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "googleapis": "^173.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
