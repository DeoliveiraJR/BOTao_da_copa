PORT=3000
WHATSAPP_VERIFY_TOKEN=botao-verify-token
TIMEZONE=America/Sao_Paulo
PERSISTENCE_PROVIDER=in_memory

# Multibolão (opcional)
# Exemplo JSON: {"copa2026":"ID_PLANILHA_1","bolao_copa_ii":"ID_PLANILHA_2"}
# Exemplo completo com nomes amigáveis:
# BOLAO_CONFIG_JSON={"copa2026":{"name":"Bolão-Zica","spreadsheetId":"ID_PLANILHA_1"},"bolao_copa_ii":{"name":"Bolão-Trader-Map","spreadsheetId":"ID_PLANILHA_2"}}
BOLAO_DEFAULT_ID=default
BOLAO_CONFIG_JSON=
BOLAO_SPREADSHEET_MAP=

GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_PREDICTIONS_RANGE=Palpites!A:J
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Twilio WhatsApp Sandbox (opcional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=+14155238886
TWILIO_SESSION_TABLE=twilio_whatsapp_sessions
BOT_AVATAR_IMAGE_URL=

# Sessão persistente Twilio por telefone (opcional, recomendado para produção)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Painel Streamlit — URL enviada pelo comando "painel" no WhatsApp
STREAMLIT_URL=https://botao-copa-2026.streamlit.app

# Bolão padrão no painel Streamlit (opcional)
CURRENT_BOLAO_ID=
